# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# This API's own public URL, no trailing slash. Must match the OAuth callbacks.
BASE_URL=http://localhost:8000

# Where the widget is allowed to run. Empty means nobody can log in at all.
ALLOWED_ORIGINS=http://localhost:3000,https://myblog.com

# Accepted data-site values. Must match the data-site on your <script> tag.
# Without this your instance is free storage for anyone who finds the URL.
ALLOWED_SITES=myblog

# These accounts can delete any comment.
ADMIN_EMAILS=you@example.com

# Callback: {BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional, these are the defaults:
# RATE_LIMIT_PER_MINUTE=5
# TOKEN_MAX_AGE_DAYS=30
